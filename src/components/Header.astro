---
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const links=[["features","Features"],["screenshots","Screenshots"],["documentation","Documentation"],["installation","Installation"],["roadmap","Roadmap"],["changelog","Changelog"]];
---
<header class="shell nav"><a class="brand" href={base+'/'}>★ Family Rewards</a><nav class="links" aria-label="Main navigation">{links.map(([path,label])=><a href={base+'/'+path+'/'}>{label}</a>)}</nav><button id="theme-toggle" type="button" aria-label="Toggle colour theme">Theme</button></header>
<script>
const button=document.querySelector('#theme-toggle');
button?.addEventListener('click',()=>{const root=document.documentElement;const theme=root.dataset.theme==='dark'?'light':'dark';root.dataset.theme=theme;try{localStorage.setItem('fr-theme',theme)}catch{}});
</script>