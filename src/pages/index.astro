---
import Base from '../layouts/Base.astro';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<Base title="Home"><section class="hero"><span class="eyebrow">Website preview · In development</span><h1>Small steps.<br/>Big achievements.</h1><p>A family-friendly approach to everyday chores, rewards and celebrating progress together.</p><a class="cta" href={base+'/features/'}>Explore the showcase</a></section><section class="cards" aria-label="Showcase topics">{['Chores and star rewards','Avatar customisation','XP and achievements','Parent and child experiences'].map(topic=><article class="panel"><h2>{topic}</h2><p>Detailed feature information will be verified before v1.0.</p></article>)}</section></Base>