---
import Base from '../layouts/Base.astro';
import ButtonLink from '../components/ButtonLink.astro';
import FeatureCard from '../components/FeatureCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Notice from '../components/Notice.astro';
import {site,sitePath} from '../lib/site';
const topics=[
{title:'Everyday chores',symbol:'✓',tone:'teal',description:'Give everyday responsibilities a clear purpose with manageable tasks.'},
{title:'Meaningful rewards',symbol:'★',tone:'apricot',description:'Earn stars and work towards rewards chosen by your family.'},
{title:'Make it your own',symbol:'✦',tone:'rose',description:'Explore avatar customisation and unlock personal touches.'},
{title:'Celebrate progress',symbol:'↗',tone:'lime',description:'Discover XP, levels, achievements and streaks as part of the journey.'}
] as const;
const steps=[['Set a task','Parents choose responsibilities and rewards that suit their household.'],['Earn stars','Children work through their tasks and celebrate their effort.'],['Enjoy the reward','Save stars towards a family-approved reward and keep growing.']];
---
<Base title="Home" description="Little Heroes Village is a self-hosted family chore and reward project designed to make everyday responsibilities more encouraging.">
<section class="hero hero-grid landing-hero">
<div class="hero-copy"><span class="eyebrow">A little adventure for every family · Pre-release</span><h1>Little heroes,<br/><span class="accent">growing together.</span></h1><p>Turn everyday chores into little wins. Build positive routines, celebrate effort and give children a rewarding way to see their progress.</p><div class="landing-actions"><ButtonLink href={sitePath('features')}>Explore features →</ButtonLink><ButtonLink href={sitePath('installation')} variant="secondary">Self-hosting guide</ButtonLink></div><p class="landing-small">Designed for families · Self-hosted project · v1.0 in development</p></div>
<div class="village-preview"><img src={sitePath()+'branding/village-scene.svg'} alt="" width="640" height="340"/><div class="panel village-progress"><span class="eyebrow">Illustrative example · Not an app screenshot</span><h2>Look how far you've come!</h2><div class="preview-row"><span class="symbol teal" aria-hidden="true">✓</span>Today's chores<strong>3 / 4</strong></div><div class="preview-row"><span class="symbol apricot" aria-hidden="true">★</span>Stars earned<strong>12</strong></div><div class="preview-row"><span class="symbol rose" aria-hidden="true">✦</span>Level<strong>5</strong></div></div></div>
</section>
<section class="landing-section" aria-label="Product benefits"><SectionHeading eyebrow="Made for families" title="Small steps. Big smiles."/><div class="cards landing-features">{topics.map(topic=><FeatureCard {...topic}/>)}</div></section>
<section class="landing-section" aria-label="How it works"><SectionHeading eyebrow="Everyday adventures" title="How it works"/><ol class="steps-grid">{steps.map(([title,description],i)=><li class="panel"><span class="step-number" aria-hidden="true">{i+1}</span><h3>{title}</h3><p>{description}</p></li>)}</ol></section>
<section class="landing-section" aria-label="Family experiences"><SectionHeading eyebrow="One family, two experiences" title="A place for everyone"/><div class="experience-grid"><article class="panel experience"><span class="eyebrow">For little heroes</span><h3>My day, my adventure</h3><p>A child-focused experience with clear tasks, stars, rewards and a personalised avatar.</p><div class="mini-task"><span aria-hidden="true">✓</span> Put toys away <strong>+2 ★</strong></div><div class="mini-task"><span aria-hidden="true">○</span> Make the bed <strong>+3 ★</strong></div><small>Illustrative task examples</small></article><article class="panel experience"><span class="eyebrow">For parents</span><h3>Your family, your rules</h3><p>Manage chores and rewards, support each child's progress and shape routines around your household.</p><div class="mini-task"><span aria-hidden="true">★</span> Reward ideas <strong>Family choice</strong></div><div class="mini-task"><span aria-hidden="true">✓</span> Daily routines <strong>Parent managed</strong></div><small>Illustrative management examples</small></article></div></section>
<section class="landing-section panel hosting-panel"><div><span class="eyebrow">Self-hosted by design</span><h2>Make your village your own.</h2><p>Little Heroes Village is being developed for self-hosted deployment using Docker and PostgreSQL. Installation guidance will be verified before v1.0.</p></div><div class="landing-actions"><ButtonLink href={sitePath('installation')}>Installation</ButtonLink><ButtonLink href={site.repository} variant="secondary">View GitHub</ButtonLink></div></section>
<section class="landing-section final-cta"><h2>Every little win matters.</h2><p>Follow the journey towards our first official release.</p><ButtonLink href={sitePath('roadmap')}>Explore the roadmap →</ButtonLink></section>
<Notice title="Pre-release website">Feature descriptions reflect the project direction and are subject to release verification. All examples are fictional; the village artwork is branding, not an interactive game feature.</Notice>
</Base>
