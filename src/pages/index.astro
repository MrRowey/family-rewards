---
import Base from '../layouts/Base.astro';
import ButtonLink from '../components/ButtonLink.astro';
import FeatureCard from '../components/FeatureCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Notice from '../components/Notice.astro';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const topics=[{title:'Everyday chores',symbol:'✓',tone:'teal',description:'A little progress every day.'},{title:'Meaningful rewards',symbol:'★',tone:'apricot',description:'Celebrate effort and milestones.'},{title:'Personal adventures',symbol:'✦',tone:'rose',description:'Explore avatars and personalisation.'},{title:'Growing together',symbol:'↗',tone:'lime',description:'Discover progress and achievements.'}] as const;
---
<Base title="Home"><section class="hero hero-grid"><div class="hero-copy"><span class="eyebrow">Little Heroes Village · Website preview</span><h1>Little heroes,<br/><span class="accent">growing together.</span></h1><p>Make everyday responsibilities a little more rewarding with a family-friendly approach to chores, stars and celebrating progress.</p><ButtonLink href={base+'/features/'}>Explore features <span aria-hidden="true">→</span></ButtonLink></div><div class="preview"><div class="panel"><span class="eyebrow">Illustrative concept · Not an app screenshot</span><h2>Little wins, big smiles</h2><p>Today's example progress</p><div class="preview-row"><span class="symbol teal" aria-hidden="true">✓</span>Chores completed<strong>3 / 4</strong></div><div class="preview-row"><span class="symbol apricot" aria-hidden="true">★</span>Stars earned<strong>12</strong></div><div class="preview-row"><span class="symbol rose" aria-hidden="true">✦</span>Level<strong>5</strong></div></div></div></section><section aria-label="Showcase topics"><SectionHeading eyebrow="Made for families" title="Make the little things count"/><div class="cards">{topics.map(topic=><FeatureCard {...topic}/>)}</div><Notice>Feature details will be verified against the application before v1.0.</Notice></section></Base>
