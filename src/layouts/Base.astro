---
import '../styles/global.css';
import {site,sitePath} from '../lib/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props {title:string;description?:string}
const {title,description='Little Heroes Village — a family chore and reward system in development.'}=Astro.props;
---
<!doctype html><html lang="en-GB"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><title>{title} | {site.name}</title><link rel="icon" href={sitePath()+'favicon.svg'}/><script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('fr-theme')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch{}</script></head><body><a class="skip-link" href="#main">Skip to content</a><Header/><main class="shell" id="main" tabindex="-1"><slot/></main><Footer/></body></html>
