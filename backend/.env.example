PORT=3001
DATABASE_PATH=./database/family.db
NODE_ENV=development

# QR Code Secrets — change these before deploying!
ADMIN_QR_SECRET=my-super-secret-admin-key-change-me
APPROVAL_QR_SECRET=my-approval-key-change-me

# Session duration for parent unlock (seconds)
PARENT_SESSION_DURATION=300

# Weekly reset day (0=Sunday, 1=Monday ... 6=Saturday)
WEEKLY_RESET_DAY=0
