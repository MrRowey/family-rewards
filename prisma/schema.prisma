datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model FamilyConfig {
  id           String   @id @default(uuid())
  parentPin    String?   
  isConfigured Boolean  @default(false)
  maxDailyTasks Int @default(5)
  updatedAt    DateTime @updatedAt
}

model Child {
  id                String             @id @default(uuid())
  name              String
  dob               DateTime
  avatar            String             @default("🦁")
  stars             Int                @default(0)
  createdAt         DateTime           @default(now())
  completions       Completion[]
  redemptions       RewardRedemption[]
  assignments       TaskAssignment[]
  rewardAssignments RewardAssignment[]
}

model Task {
  id          String           @id @default(uuid())
  title       String
  icon        String           @default("⭐")
  starValue   Int              @default(1)
  minAge      Int              @default(2)
  maxAge      Int              @default(18)
  createdAt   DateTime         @default(now())
  subSteps    SubStep[]
  completions Completion[]
  assignments TaskAssignment[]
}

model SubStep {
  id        String  @id @default(uuid())
  taskId    String
  title     String
  order     Int     @default(0)
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskAssignment {
  id        String @id @default(uuid())
  childId   String
  child     Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  dayOfWeek Int
}

model Completion {
  id          String   @id @default(uuid())
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING") // PENDING, APPROVED, DECLINED
  completedAt DateTime @default(now())
}

model Reward {
  id           String             @id @default(uuid())
  title        String
  icon         String             @default("🎁")
  starCost     Int                @default(5)
  monthlyStock Int                @default(1)
  currentStock Int                @default(1)
  minAge       Int                @default(2)
  maxAge       Int                @default(18)
  createdAt    DateTime           @default(now())
  redemptions  RewardRedemption[]
  assignments  RewardAssignment[]
}

model RewardAssignment {
  id       String @id @default(uuid())
  childId  String
  child    Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  rewardId String
  reward   Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
}

model RewardRedemption {
  id          String   @id @default(uuid())
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  rewardId    String
  reward      Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING") // PENDING, APPROVED, DECLINED
  requestedAt DateTime @default(now())
}