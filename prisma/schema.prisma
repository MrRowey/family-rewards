datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model FamilyConfig {
  id              String    @id @default(uuid())
  parentPin       String?   
  isConfigured    Boolean   @default(false)
  maxDailyTasks   Int       @default(5)
  idleTimeoutSec  Int       @default(45)   // Kiosk auto-return timeout (seconds)
  soundEffects    Boolean   @default(true) // Global kiosk SFX toggle
  updatedAt       DateTime  @updatedAt
}

model Child {
  id                String             @id @default(uuid())
  name              String
  avatar            String             @default("🦁") // Emoji or image URL/path
  avatarTheme       String?            @default("bottts")
  avatarConfig      String?            // Json String for DiceBear Options
  stars             Int                @default(0)
  dob               DateTime
  createdAt         DateTime           @default(now())
  assignments       TaskAssignment[]
  completions       Completion[]
  redemptions       RewardRedemption[]
  rewardAssignments RewardAssignment[]
  groupPledges      GroupRewardPledge[]
  badges            ChildBadge[]
}

model Badge {
  id           String       @id @default(uuid())
  title        String
  description  String
  icon         String       // e.g. "🤖", "⭐", "🏆"
  ruleType     String       // "TOTAL_TASKS" | "STREAK_DAYS"
  threshold    Int          @default(5)
  unlockedItem String?
  childBadges  ChildBadge[]
  createdAt    DateTime     @default(now())
}

model ChildBadge {
  id        String   @id @default(uuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([childId, badgeId])
}

model Task {
  id          String           @id @default(uuid())
  title       String
  icon        String           @default("⭐")
  imageURL    String?          
  starValue   Int              @default(1)
  minAge      Int              @default(2)
  maxAge      Int              @default(18)
  createdAt   DateTime         @default(now())
  subSteps    SubStep[]
  completions Completion[]
  assignments TaskAssignment[]
}

model SubStep {
  id        String  @id @default(uuid())
  taskId    String
  title     String
  order     Int     @default(0)
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskAssignment {
  id              String    @id @default(uuid())
  childId         String
  child           Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  taskId          String
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  dayOfWeek       Int       // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  repeatInterval  Int       @default(1)     // 1 = every week, 2 = every 2 weeks, etc.
  startDate       DateTime  @default(now()) @db.Date // Cadence baseline
  endDate         DateTime? @db.Date        // Optional expiration date
}

model Completion {
  id          String   @id @default(uuid())
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING") // PENDING, APPROVED, DECLINED
  forDate     DateTime @db.Date
  completedAt DateTime @default(now())

  @@unique([childId, taskId, forDate])
}

model Reward {
  id           String             @id @default(uuid())
  title        String
  description  String?
  icon         String             @default("🎁")
  imageURL     String?            
  starCost     Int                @default(5)
  monthlyStock Int                @default(1)
  currentStock Int                @default(1)
  minAge       Int                @default(2)
  maxAge       Int                @default(18)
  isVisible    Boolean            @default(true)
  isGroup      Boolean            @default(false) 
  targetMonth  Int?               
  createdAt    DateTime           @default(now())
  redemptions  RewardRedemption[]
  assignments  RewardAssignment[]
  groupPledges GroupRewardPledge[]
}

model GroupRewardPledge {
  id        String    @id @default(uuid())
  rewardId  String
  reward    Reward    @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  childId   String
  child     Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  stars     Int
  createdAt DateTime  @default(now())
}

model RewardAssignment {
  id       String @id @default(uuid())
  childId  String
  child    Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  rewardId String
  reward   Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([childId, rewardId])
}

model RewardRedemption {
  id          String   @id @default(uuid())
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  rewardId    String
  reward      Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING") // PENDING, APPROVED, DECLINED
  requestedAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String   
  actorType String   // "PARENT" | "CHILD"
  action    String   
  details   String
  createdAt DateTime @default(now())
}