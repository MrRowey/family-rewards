datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model FamilyConfig {
  id              String    @id @default(uuid())
  parentPinLength Int?
  parentPin       String?   
  isConfigured    Boolean   @default(false)
  xpMinMultiplier Int       @default(5)
  xpMaxMultiplier Int       @default(8)
  coinsPerLevel   Int       @default(25)
  milestoneBonusCoins Int   @default(50)
  maxDailyTasks   Int       @default(5)
  idleTimeoutSec  Int       @default(45)   // Kiosk auto-return timeout (seconds)
  largeKioskText  Boolean   @default(false)
  reducedMotion   Boolean   @default(false)
  showPickerStars Boolean   @default(true)
  soundEffects    Boolean   @default(true) // Global kiosk SFX toggle
  updatedAt       DateTime  @updatedAt
}

model Child {
  id                String             @id @default(uuid())
  name              String
  avatar            String             @default("🦁") // Emoji or image URL/path
  avatarTheme       String?            @default("bottts")
  avatarConfig      String?            // Json String for DiceBear Options
  stars             Int                @default(0)
  avatarCoins       Int                @default(0)
  avatarCoinDebt    Int                @default(0)
  starDebt          Int                @default(0)
  xp                Int                @default(0)
  rewardedLevel     Int                @default(1)
  avatarUnlocks     AvatarUnlock[]
  avatarMilestones  AvatarMilestone[]
  xpLedger          XpLedger[]
  currencyLedger    AvatarCurrencyLedger[]
  kioskMode         String             @default("AUTO") // AUTO, JUNIOR, EXPLORER, TEEN
  dob               DateTime
  createdAt         DateTime           @default(now())
  assignments       TaskAssignment[]
  completions       Completion[]
  redemptions       RewardRedemption[]
  rewardAssignments RewardAssignment[]
  shopPlans         ShopPlan[]
  groupPledges      GroupRewardPledge[]
  badges            ChildBadge[]
}

model Badge {
  id           String       @id @default(uuid())
  title        String
  description  String
  icon         String       // e.g. "🤖", "⭐", "🏆"
  ruleType     String       // "TOTAL_TASKS" | "STREAK_DAYS"
  threshold    Int          @default(5)
  unlockedItem String?
  childBadges  ChildBadge[]
  createdAt    DateTime     @default(now())
}

model ChildBadge {
  id        String   @id @default(uuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())
  celebrationSeenAt DateTime?

  @@unique([childId, badgeId])
}

model Task {
  category     String?
  id          String           @id @default(uuid())
  title       String
  icon        String           @default("⭐")
  imageURL    String?          
  starValue   Int              @default(1)
  minAge      Int              @default(2)
  maxAge      Int              @default(18)
  createdAt   DateTime         @default(now())
  subSteps    SubStep[]
  completions Completion[]
  assignments TaskAssignment[]
}

model SubStep {
  id        String  @id @default(uuid())
  taskId    String
  title     String
  order     Int     @default(0)
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskAssignment {
  id              String    @id @default(uuid())
  childId         String
  child           Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  taskId          String
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  dayOfWeek       Int       // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  repeatInterval  Int       @default(1)     // 1 = every week, 2 = every 2 weeks, etc.
  startDate       DateTime  @default(now()) @db.Date // Cadence baseline
  endDate         DateTime? @db.Date        // Optional expiration date
}

model Completion {
  id          String   @id @default(uuid())
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING") // PENDING, APPROVED, DECLINED
  forDate     DateTime @db.Date
  completedAt DateTime @default(now())
  starsAwarded Int?

  @@unique([childId, taskId, forDate])
}

model Reward {
  category     String?
  id           String             @id @default(uuid())
  title        String
  description  String?
  icon         String             @default("🎁")
  imageURL     String?            
  starCost     Int                @default(5)
  monthlyStock Int                @default(1)
  currentStock Int                @default(1)
  minAge       Int                @default(2)
  maxAge       Int                @default(18)
  isArchived   Boolean            @default(false)
  isVisible    Boolean            @default(true)
  isGroup      Boolean            @default(false) 
  targetMonth  Int?               
  createdAt    DateTime           @default(now())
  redemptions  RewardRedemption[]
  assignments  RewardAssignment[]
  groupPledges GroupRewardPledge[]
}

model GroupRewardPledge {
  id        String    @id @default(uuid())
  rewardId  String
  reward    Reward    @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  childId   String
  child     Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  stars     Int
  createdAt DateTime  @default(now())
}

model RewardAssignment {
  id       String @id @default(uuid())
  childId  String
  child    Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  rewardId String
  reward   Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([childId, rewardId])
}

model RewardRedemption {
  id          String   @id @default(uuid())
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  rewardId    String
  reward      Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING") // PENDING, APPROVED, DECLINED
  stockReserved Boolean @default(false) // Legacy claims did not reserve stock on creation
  refundState     String? // PENDING, APPROVED, DECLINED
  starCostAtClaim Int? // Null for legacy claims created before price snapshots
  requestedAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String   
  actorType String   // "PARENT" | "CHILD"
  action    String   
  details   String
  createdAt DateTime @default(now())
}
model ShopPlan {
  childId   String
  year      Int
  month     Int
  rewardIds String[]
  child     Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@id([childId, year, month])
}

// A purchased cosmetic is permanently owned for its particular theme and component.
model AvatarUnlock {
  id        String   @id @default(uuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  theme     String
  component String
  variant   String
  cost      Int
  createdAt DateTime @default(now())

  @@unique([childId, theme, component, variant])
}

model XpLedger {
  id          String   @id @default(uuid())
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  sourceKey   String
  delta       Int
  stars       Int
  minFactor   Int
  maxFactor   Int
  createdAt   DateTime @default(now())
  @@unique([childId, sourceKey])
  @@index([childId, createdAt])
}

model AvatarCurrencyLedger {
  id          String   @id @default(uuid())
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  sourceKey   String
  delta       Int
  debtDelta   Int      @default(0)
  reason      String
  createdAt   DateTime @default(now())
  @@unique([childId, sourceKey])
  @@index([childId, createdAt])
}

model AvatarMilestone {
  id             String   @id @default(uuid())
  childId        String
  child          Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  level          Int
  policyVersion  Int      @default(1)
  bonusCoins     Int
  cosmeticKey    String
  createdAt      DateTime @default(now())
  @@unique([childId, level, policyVersion])
  @@unique([childId, cosmeticKey])
}
