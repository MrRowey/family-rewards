# Copy to .env and replace placeholders before starting Docker Compose.
# Do not commit .env to Git.
POSTGRES_USER=family_admin
POSTGRES_DB=family_rewards
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Set true when serving the app through HTTPS.
COOKIE_SECURE=false
