{
  "name": "family-rewards",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint .",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "kiosk:up": "powershell -ExecutionPolicy Bypass -File ./setup.ps1",
    "kiosk:down": "docker compose down",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "howler": "^2.2.4",
    "jose": "^6.2.17",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7",
    "@dicebear/styles": "^10.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/mocker": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^7",
    "vitest": "^5.1.1",
    "oxlint": "^1.0.0"
  },
  "overrides": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "deepmerge-ts": "^8.0.0",
    "tinypool": "^2.1.2"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true,
    "unrs-resolver": true
  }
}
